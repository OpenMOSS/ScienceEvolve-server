PORT=4311
HOST=127.0.0.1
# Vite defaults to 0.0.0.0:5173. Set SCIENCEEVOLVE_WEB_HOST, SCIENCEEVOLVE_API_URL
# and SCIENCEEVOLVE_WEB_BASE in the process environment when running npm run dev;
# this Server .env file does not automatically configure Vite.
SCIENCEEVOLVE_DATA_DIR=./data
# Leave empty to prefer the installed harness/codex CLI. For an external CLI,
# set its absolute path; setting "codex" instead requires it to be on PATH.
SCIENCEEVOLVE_CODEX_BIN=
# Inspire CLI used by compute Workers. The CLI is resolved from this explicit path
# or from PATH when this remains "inspire".
SCIENCEEVOLVE_INSPIRE_BIN=inspire
# Local filesystem boundary for compute Worker workspaces. This is not a remote
# Inspire Workspace or billing Project. It must contain the actual Agent
# workspaces under SCIENCEEVOLVE_DATA_DIR. Replace this legacy default for your host;
# with the default ./data, use the absolute repository path printed by pwd.
SCIENCEEVOLVE_INSPIRE_WORKSPACE_ROOT=/inspire/qb-ilm
# Optional legacy/global config layer; this does not replace the CLI 6.x account store.
SCIENCEEVOLVE_INSPIRE_CONFIG_PATH=
# Comma-separated hosts that Inspire CLI should reach without the shell HTTP proxy.
SCIENCEEVOLVE_INSPIRE_NO_PROXY=
# Code-only CPU/GPU experiment probes; the model does not poll while deferred.
SCIENCEEVOLVE_SII_REFRESH_MS=30000
# Extra directories containing <skill-name>/SKILL.md, separated by the OS path delimiter.
SCIENCEEVOLVE_SKILL_ROOTS=
# Optional comma-separated model suggestions shown in the UI.  The current
# real-acceptance configuration selects the Kimi model confirmed by AIGW.
# Keep OPENFARS_AIGW_ACCEPTANCE_MODELS=kimi-k3 explicit for real acceptance;
# do not silently reintroduce the superseded Nex model.
SCIENCEEVOLVE_MODELS=kimi-k3
# On a fresh data directory, a configured AIGW key seeds the editable system
# gateway once. Removing the gateway later is respected and will not re-seed
# it while data/gateways.json exists. Never commit a real key here.
AIGW_BASE_URL=https://aigw.sotatts.online/v1
AIGW_API_KEY=
# Maximum simultaneous Codex invocations for each Agent role.
SCIENCEEVOLVE_AGENT_CONCURRENCY=10
SCIENCEEVOLVE_RETRY_BASE_MS=2000
SCIENCEEVOLVE_RETRY_MAX_MS=60000
# DSH JSON-RPC handshake deadline. Turn execution uses the activity deadline below.
SCIENCEEVOLVE_DSH_HANDSHAKE_TIMEOUT_MS=60000
# DSH/provider inactivity deadline; continuous model/SSE activity resets this timer.
SCIENCEEVOLVE_DSH_TURN_IDLE_TIMEOUT_MS=1200000
SCIENCEEVOLVE_PROTOCOL_PROXY_TIMEOUT_MS=1200000
# Maximum events included in a normal project snapshot; SSE recovery streams the full backlog.
SCIENCEEVOLVE_MAX_EVENT_HISTORY=10000
# GitHub OAuth App used by the global account library. The callback must share
# the browser page's origin and reach /api/github/auth/callback (via Vite in dev).
# The deployment owner registers the OAuth App; site users only authorize it.
# Use the App's Client ID/Secret, not a PAT, GitHub password or model API key.
# Local production (npm start) serves the browser on port 4311: change this
# callback and the OAuth App's callback together when switching from dev.
# Request only the repo scope;
# ScienceEvolve does not request workflow/Actions permission.
SCIENCEEVOLVE_GITHUB_OAUTH_CLIENT_ID=
SCIENCEEVOLVE_GITHUB_OAUTH_CLIENT_SECRET=
# Prefer this file-based alternative when the secret is provisioned separately.
SCIENCEEVOLVE_GITHUB_OAUTH_CLIENT_SECRET_FILE=
SCIENCEEVOLVE_GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:5173/api/github/auth/callback
